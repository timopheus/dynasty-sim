{
  "name": "dynasty-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Text-based dynasty simulator with procedural storylet events.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p src/core && tsc -p src/ui && tsc -p .",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "sim": "tsx tools/sim.ts",
    "gates": "tsx tools/gates.ts",
    "replay": "tsx tools/replay.ts",
    "save-bench": "tsx tools/save-bench.ts",
    "check": "npm run typecheck && npm test && npm run validate && npm run sim -- --years 50 --seed 1",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
